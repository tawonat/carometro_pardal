# Copie para .env. Nunca publique o arquivo .env no GitHub.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elo_carometro
# O setup usa uma conta administrativa somente para criar a base e a conta limitada.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
DB_USER=elo_app
DB_PASSWORD=troque_esta_senha_local
# Conta criada somente quando ainda não existe. Alterar isto não redefine usuários existentes.
DEMO_EMAIL=professor@elo.local
DEMO_PASSWORD=Elo@2026!
# Localhost usa HTTP; só ative ao executar com HTTPS.
COOKIE_SECURE=false
# URL do servidor já em execução para os testes de integração.
TEST_BASE_URL=http://localhost:3000

# Opcional: acesso sem senha aos dados fictícios. Mantenha false para uso com dados reais.
DEMO_ACCESS=false
